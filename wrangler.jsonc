// The landing site at https://kcp.cecs.sh/ (ADR-0066), served by Cloudflare Workers
// static assets with no Worker script. Deploy with `npx wrangler deploy` from the
// repository root, or through Workers Builds with that deploy command.
{
  "name": "kcp-landing",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    // /en redirects to /en/, which serves en/index.html, and /index.html to /.
    "html_handling": "auto-trailing-slash",
    // An unknown path answers 404 with the nearest 404.html, here the bilingual root one.
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "kcp.cecs.sh", "custom_domain": true }],
  // The custom domain is the only public address, so the pages are never indexed twice.
  "workers_dev": false,
  "preview_urls": false,
}
