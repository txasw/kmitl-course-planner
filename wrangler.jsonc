// The landing site at https://kcp.cecs.sh/ (ADR-0066), served by Cloudflare Workers
// static assets with no Worker script. Workers Builds deploys it from main with
// `pnpm exec wrangler deploy`, the Wrangler version pinned in package.json; the settings
// are in CONTRIBUTING.md. The same command deploys it by hand from the repository root.
{
  "name": "kcp-landing",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    // /en redirects to /en/, which serves en/index.html, and /index.html to /.
    "html_handling": "auto-trailing-slash",
    // An unknown path answers 404 with the nearest 404.html: en/404.html, led in English,
    // under /en/, and the root one, led in Thai, everywhere else. Both carry both languages.
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "kcp.cecs.sh", "custom_domain": true }],
  // The custom domain is the only public address, so the pages are never indexed twice.
  "workers_dev": false,
  "preview_urls": false,
  // The project sends no usage data anywhere, and its deploy tool does not either.
  "send_metrics": false,
}
